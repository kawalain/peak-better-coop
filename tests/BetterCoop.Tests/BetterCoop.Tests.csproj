<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Covers game-independent logic only (pairing, rules). Tests must not touch
    Unity, Photon, or game types: those assemblies are not copied here.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BetterCoop\BetterCoop.csproj" />
  </ItemGroup>

  <!--
    FakeRoom is a development tool: only a Debug plugin has it. Any other
    configuration compiles it here, so the tests reach it either way.
  -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Include="..\..\src\BetterCoop\DevTools\FakeRoom.cs" Link="DevTools\FakeRoom.cs" />
  </ItemGroup>

</Project>
