<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BetterCoop</AssemblyName>
    <RootNamespace>BetterCoop</RootNamespace>
    <Product>BetterCoop</Product>
    <Version>0.5.4</Version>
    <BepInExPluginGuid>in.kawala.bettercoop</BepInExPluginGuid>
    <BepInExPluginName>BetterCoop</BepInExPluginName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(PeakManagedDir)\Assembly-CSharp.dll" Publicize="true" Private="false" />
    <Reference Include="$(PeakManagedDir)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(PeakManagedDir)\com.rlabrecque.steamworks.net.dll" Private="false" />
    <Reference Include="$(PeakManagedDir)\UnityEngine*.dll" Private="false" />
    <Reference Include="$(PeakManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(PeakManagedDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(PeakManagedDir)\Photon*.dll" Private="false" />
    <Reference Include="$(PeakManagedDir)\Zorro.Core.Runtime.dll" Private="false" />
    <Reference Include="$(PeakManagedDir)\Zorro.Settings.Runtime.dll" Private="false" />
    <Reference Include="$(PeakManagedDir)\Zorro.ControllerSupport.dll" Private="false" />
    <Reference Include="$(PeakManagedDir)\Zorro.UI.Runtime.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BetterCoop.Tests" />
  </ItemGroup>

  <!--
    Development tools (the Zoo, Solo Pair, the Twin, the Control Line) live in
    DevTools/ and reach the plugin only through DevHooks.cs. Any build but
    Debug leaves the folder out, so test builds and releases cannot contain them.
  -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="DevTools\**" />
  </ItemGroup>

  <!--
    Belt and braces: a build without DevTools/ is refused if the plugin still
    names anything from it (its namespace, or a hook's development body).
  -->
  <UsingTask TaskName="BetterCoopFindNames" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
      <Names ParameterType="System.String" Required="true" />
      <Found ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        byte[] bytes = System.IO.File.ReadAllBytes(File);
        var found = new System.Collections.Generic.List<string>();
        foreach (string name in Names.Split(';'))
        {
            foreach (byte[] needle in new[] { System.Text.Encoding.UTF8.GetBytes(name), System.Text.Encoding.Unicode.GetBytes(name) })
            {
                for (int i = 0; i + needle.Length <= bytes.Length; i++)
                {
                    int j = 0;
                    while (j < needle.Length && bytes[i + j] == needle[j]) j++;
                    if (j == needle.Length) { found.Add(name); goto next; }
                }
            }
            next:;
        }
        Found = string.Join(", ", found);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="CheckNoDevTools" AfterTargets="Build" BeforeTargets="PackageTestBuild" Condition="'$(Configuration)' != 'Debug'">
    <BetterCoopFindNames File="$(TargetPath)" Names="BetterCoop.DevTools;OnStarted;OnPauseMenu;SoloPairWanted;OnHandPictured;Solo Pair;ZooPage">
      <Output TaskParameter="Found" PropertyName="DevToolsFound" />
    </BetterCoopFindNames>
    <Error Condition="'$(DevToolsFound)' != ''" Text="The $(Configuration) build still has development tools in it: $(DevToolsFound). Keep them in DevTools/ and reach them only through DevHooks." />
    <Message Importance="high" Text="Checked $(TargetFileName): no development tools in it." />
  </Target>

  <!-- Opt-in: copy the plugin into a mod-manager profile set in Directory.Build.user.props. -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="'$(BetterCoopDeployDir)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BetterCoopDeployDir)" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(BetterCoopDeployDir)" />
  </Target>

  <!--
    Release builds also produce a Thunderstore-format zip in artifacts/ that
    players import into Gale as a local mod and tools/publish.py uploads to
    Thunderstore. The build itself uploads nothing.
  -->
  <PropertyGroup>
    <PackageStageDir>$(BaseIntermediateOutputPath)package\</PackageStageDir>
    <PackageZip>$(MSBuildThisFileDirectory)..\..\artifacts\BetterCoop-$(Version).zip</PackageZip>
  </PropertyGroup>

  <Target Name="PackageTestBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ManifestJson><![CDATA[{
  "name": "BetterCoop",
  "version_number": "$(Version)",
  "website_url": "",
  "description": "Climb PEAK in Pairs: the Carrier carries the Rider, the Carrier drives the body with the keyboard and the Rider with the mouse.",
  "dependencies": ["BepInEx-BepInExPack_PEAK-5.4.75301"]
}]]></ManifestJson>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildThisFileDirectory)..\..\README.md;$(MSBuildThisFileDirectory)..\..\LICENSE;$(MSBuildThisFileDirectory)..\..\icon.png" DestinationFolder="$(PackageStageDir)" />
    <WriteLinesToFile File="$(PackageStageDir)manifest.json" Lines="$(ManifestJson)" Overwrite="true" />
    <MakeDir Directories="$(MSBuildThisFileDirectory)..\..\artifacts" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Packaged $(PackageZip)" />
  </Target>

</Project>
